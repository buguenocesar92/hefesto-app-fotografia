# =============================================================================
# Caddy de Fotografía
# =============================================================================
# Un solo dominio público. Termina TLS y reparte:
#   /api/*  -> la API de Laravel
#   /       -> la interfaz de Nuxt
#
# POR QUÉ UN DOMINIO Y NO DOS
# ---------------------------
# La cookie de sesión tiene que viajar del navegador a la interfaz y de la interfaz
# a la API en el mismo origen. Con dos subdominios habría que hacer una cookie de
# dominio compartido, que es más frágil y más difícil de auditar. Y en un estudio,
# donde la sesión abre la ficha completa de una persona y la lista de sus sesiones,
# "más difícil de auditar" es exactamente el argumento que importa.
#
# NOTA: en Caddy el bloque global de respuesta es `header`, con dos espacios.
# =============================================================================

{
	email {$ACME_EMAIL:admin@hefesto.cl}
}

{$DOMINIO:fotografia.ejemplo.cl} {
	encode zstd gzip

	# Cabeceras de endurecimiento. `Strict-Transport-Security` solo tiene
	# sentido con TLS, así que se agrega acá y no en el servidor de la API.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		# La aplicación no carga recursos de terceros: la política lo refleja.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	@api path /api/*

	handle @api {
		# `no-store` también viene de la API. Se repite acá para que ninguna capa
		# intermedia (CDN, proxy del estudio) guarde una respuesta que contiene
		# nombres de personas y listas de sus sesiones.
		header Cache-Control "no-store, no-cache, must-revalidate, private"

		reverse_proxy api:8000
	}

	handle {
		header Cache-Control "no-store, no-cache, must-revalidate, private"

		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
		# El registro de acceso de Caddy NO guarda cuerpos ni cookies: solo método,
		# ruta, estado y tiempo.
	}
}