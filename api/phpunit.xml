<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuracion de PHPUnit de Fotografia.

    Las suites `Aislamiento`, `Cobranza`, `Contratos` y `Sesiones` estan
    separadas a proposito:

      - `Aislamiento`: un estudio no puede leer los datos de otro. Usa Row Level
        Security de PostgreSQL.
      - `Cobranza`: el calculo del saldo devuelve el DESGLOSE, no solo el total,
        y el total abonado nunca borra lo que falta por entregar.
      - `Contratos`: una entrega parcial NO cierra el contrato.
      - `Sesiones`: una sesion no se marca entregada sin seleccion confirmada.

    Se pueden correr solas:
        php artisan test --testsuite=Aislamiento
        php artisan test --testsuite=Cobranza
        php artisan test --testsuite=Contratos
        php artisan test --testsuite=Sesiones
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Aislamiento">
            <directory>tests/Feature/Aislamiento</directory>
        </testsuite>
        <testsuite name="Cobranza">
            <directory>tests/Feature/Cobranza</directory>
        </testsuite>
        <testsuite name="Contratos">
            <directory>tests/Feature/Contratos</directory>
        </testsuite>
        <testsuite name="Sesiones">
            <directory>tests/Feature/Sesiones</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
            IMPORTANTE: la base de pruebas TIENE que ser PostgreSQL, no SQLite.

            El aislamiento entre estudios esta implementado con Row Level
            Security, que es una funcion de PostgreSQL. En SQLite estas pruebas
            pasarían sin comprobar nada: un sistema sin aislamiento alguno tambien
            daria verde, porque SQLite no tiene RLS que lo niegue.

            Ver docs/10.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="fotografia_test"/>
    </php>
</phpunit>