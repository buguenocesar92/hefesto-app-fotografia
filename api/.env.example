# =============================================================================
# Hefesto Studio — Fotografía: API (Laravel)
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
# =============================================================================

APP_NAME="Fotografía"
# `local` en desarrollo, `production` en producción.
APP_ENV=local
# En producción tiene que ser `false`: el registro con nivel `debug` puede
# incluir el cuerpo de una petición, y en un estudio eso incluye el nombre de la
# persona de la que son las fotos que se están por entregar.
APP_DEBUG=false
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_KEY=
# Genere la clave con: php artisan key:generate

LOG_CHANNEL=stack
LOG_STACK=single,stderr
# `debug` deja el cuerpo de las peticiones en el registro. En producción tiene
# que ser `info` o más alto.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# PostgreSQL, obligatorio. La Row Level Security no existe en otro motor, y el
# aislamiento entre estudios depende de ella. Ver docs/03.
#
# El rol de la aplicación NO puede ser superusuario ni tener BYPASSRLS: con
# cualquiera de los dos, PostgreSQL ignora las políticas. En desarrollo lo crea
# el script `deploy/postgres/inicializar-rol.sh` que el compose monta en
# `/docker-entrypoint-initdb.d/`. Ver docs/03.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fotografia
DB_USERNAME=fotografia_app
DB_PASSWORD=
# `prefer` sirve dentro de la red de Compose. Si la base queda afuera de la
# instalación, use `require` y revise la cadena de conexión. Ver docs/04.
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (caché, sesiones y colas)
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
# Minutos que dura una sesión abierta. En un estudio conviene poco: el equipo se
# turna en el mismo puesto, y una sesión abierta mucho rato es una sesión
# abierta a la ficha de la persona de la que son las fotos que se están por
# entregar.
SESSION_EXPIRACION_MINUTOS=120
# `true` en producción, con TLS válido en el dominio.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Authentik (identidad de Hefesto)
# -----------------------------------------------------------------------------
# URL pública del emisor, SIN barra final. El descubrimiento OIDC se lee de
# `<AUTHENTIK_ISSUER>/.well-known/openid-configuration`.
AUTHENTIK_ISSUER=
# Cliente OIDC EXCLUSIVO de esta aplicación: así se puede revocar el acceso a
# Fotografía sin tocar las demás aplicaciones de Hefesto.
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Debe coincidir exactamente con la URL de retorno configurada en Authentik.
AUTHENTIK_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
AUTHENTIK_ALGORITMO=RS256
# Audiencia esperada del `id_token`. Si se deja vacía, se usa el identificador
# del cliente.
AUTHENTIK_AUDIENCE=
AUTHENTIK_LEEWAY=60
AUTHENTIK_CACHE_METADATA=60
AUTHENTIK_CACHE_JWKS=1440
# Prefijo del equipo de Authentik que declara el estudio. El grupo completo es
# `estudio-<identificador>`. Ver docs/05.
AUTHENTIK_GRUPO_POR_ESTUDIO=estudio
# Los nombres de estos equipos son valores de configuración, no texto de
# pantalla: pueden llevar tilde, pero deben coincidir con Authentik.
AUTHENTIK_EQUIPO_RECEPCION="Recepción de Fotografía"
AUTHENTIK_EQUIPO_FOTOGRAFO="Fotografía de Hefesto"
AUTHENTIK_EQUIPO_ADMINISTRACION="Administración de Fotografía"

# -----------------------------------------------------------------------------
# Agenda de sesiones
# -----------------------------------------------------------------------------
# Red de seguridad para cuando el paquete tiene un dato raro. La duración de una
# sesión NO sale de acá: sale de la línea del contrato que la promete. Ver docs/02.
FOTOGRAFIA_DURACION_MAXIMA_MINUTOS=600
FOTOGRAFIA_ANTICIPACION_MAXIMA_DIAS=540

# -----------------------------------------------------------------------------
# Paquetes y fecha prometida
# -----------------------------------------------------------------------------
# DÍAS que se suman a la fecha de la sesión para anunciar la entrega de las
# fotos. NO HAY VALOR POR OMISIÓN.
#
# Es verdad que el plazo es una promesa del estudio, no una regla técnica, y por
# eso se configura por instalación y no se escribe en el software. Poner un
# número acá sería prometer al cliente una fecha que nadie acordó. El valor por
# omisión es `null` y la pantalla lo declara.
FOTOGRAFIA_DIAS_PROMESA_ENTREGA=
# Cuántos días de anticipación mínima se aceptan al agendar. Esto sí es una
# restricción técnica de la agenda, no una promesa comercial. Cero significa que
# se acepta agendar para hoy, que es lo normal en un estudio chico que tiene
# huecos.
FOTOGRAFIA_ANTICIPACION_MINIMA_DIAS=0

# -----------------------------------------------------------------------------
# Impresión: SUBCONTRATO, NO VENTA DE PAPEL
# -----------------------------------------------------------------------------
# El estudio ENCARGA la impresión a un laboratorio externo. Por eso acá no hay
# formatos con precio: los formatos y sus precios los declara cada estudio en
# sus paquetes y en cada pedido al laboratorio.
#
# Lo único que se configura es el plazo prometido por omisión, y también nace
# vacío. Ver docs/05.
FOTOGRAFIA_DIAS_PROMESA_LABORATORIO=
# Formatos que el sistema acepta en un pedido. VACÍO A PROPÓSITO: cada estudio
# trabaja con los que su laboratorio ofrece.
FOTOGRAFIA_FORMATOS_IMPRESION=

# -----------------------------------------------------------------------------
# Abonos
# -----------------------------------------------------------------------------
# PORCENTAJE DE ABONO AL CONTRATAR.
#
# El cincuenta por ciento al contratar y el resto al entregar es la forma en que
# el mundo del rubro describió el ciclo de caja, así que se usa como valor por
# omisión. NO ES UN DATO LEGAL NI UN PRECIO: es la política de la instalación, y
# se cambia acá cuando el estudio cambie la suya.
FOTOGRAFIA_PORCENTAJE_ABONO_INICIAL=50
# Si el abono inicial es obligatorio para activar el contrato.
FOTOGRAFIA_EXIGIR_ABONO_INICIAL=true
# Si se admite un abono parcial (la caja del estudio a veces lo necesita).
FOTOGRAFIA_PERMITIR_ABONO_PARCIAL=true

# -----------------------------------------------------------------------------
# Selección de fotos
# -----------------------------------------------------------------------------
# DÍAS que se espera para que la persona elija. NO HAY VALOR POR OMISIÓN: el
# plazo depende del tipo de sesión y no se pudo verificar un número para todo el
# rubro. Con `null` no se avisa a nadie y la sesión queda visible en la lista de
# pendientes. Ver docs/02.
FOTOGRAFIA_DIAS_PARA_SELECCION=
# Cuántas fotos se pueden marcar por encima de las que el paquete promete, sin
# que el sistema las cobre. Con `null` no se avisa y se permite.
FOTOGRAFIA_EXCESO_SELECCION_SIN_PAGO=

# -----------------------------------------------------------------------------
# CONSERVACIÓN DE LOS ARCHIVOS: ESTA ES LA PARTE DELTA
# -----------------------------------------------------------------------------
# Un estudio entrega las fotos "de por vida". Eso obliga a saber dónde están y
# si el medio sigue vivo, y no a poner un texto libre en una ficha.
#
# Cada cuánto se revisa el medio. Es una decisión del estudio y no una regla
# legal, por eso sí tiene valor por omisión.
FOTOGRAFIA_DIAS_ENTRE_VERIFICACIONES=30
# DÍAS sin verificar una conservación antes de que el sistema avise. NO HAY
# VALOR POR OMISIÓN: no se pudo verificar un número para el rubro. Con `null` el
# sistema no avisa por sí solo, y la pantalla muestra la fecha de la última
# verificación. Ver docs/08.
FOTOGRAFIA_DIAS_MAX_SIN_VERIFICAR=

# -----------------------------------------------------------------------------
# CONSERVACIÓN: ESTA DECISIÓN ES DEL CLIENTE, NO DEL SOFTWARE
# -----------------------------------------------------------------------------
# La Ley 19.628 obliga a que la conservación de datos personales tenga una
# finalidad declarada, pero no se pudo verificar en este entorno el plazo que
# corresponde a los originales de un estudio fotográfico. Por eso estas
# variables NACEN VACÍAS.
#
# Vacía significa: "no hay plazo configurado". La aplicación NO purga nada por su
# cuenta. Borrar originales porque pasó un número inventado sería la peor
# pérdida posible en este rubro. Ver docs/07.
#
# COMPLETAR solo cuando el estudio cliente, con su revisión legal, tenga un plazo
# escrito. El valor va en DÍAS.
FOTOGRAFIA_RETENCION_ACCESOS_ARCHIVO_DIAS=
FOTOGRAFIA_AVISAR_ANTES_DE_PURGAR=false