# =============================================================================
# Fotografía: interfaz
# =============================================================================
# Copie este archivo a `.env` y complete los valores.
# NUNCA versione el `.env` con valores reales.
# =============================================================================

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# URL INTERNA de la API de Laravel. Solo la usa el servidor de Nuxt: nunca viaja
# al navegador. Dentro de la red de Compose, el nombre del servicio.
NUXT_API_BASE=http://api:8000

# URL pública de la interfaz, sin barra final. Se usa para armar el enlace de
# retorno del ingreso.
NUXT_PUBLIC_BASE=http://localhost:3000

# Días hacia atrás que se ofrecen como período en la pantalla de saldos. Es una
# ayuda de navegación: el período lo elige quien mira.
NUXT_DIAS_SALDOS=90